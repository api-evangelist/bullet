{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bullet Trading Account User Data (Beta) API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "User Data (Beta)",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "All Orders (order history from ClickHouse)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/fapi/v1/allOrders",
            "params": [
              {
                "name": "address",
                "value": "",
                "type": "query",
                "description": "Account address (required on first request, encoded in cursor for subsequent)"
              },
              {
                "name": "symbol",
                "value": "",
                "type": "query",
                "description": "Trading pair symbol (optional filter)"
              },
              {
                "name": "orderId",
                "value": "",
                "type": "query",
                "description": "Return orders with orderId >= this value"
              },
              {
                "name": "startTime",
                "value": "",
                "type": "query",
                "description": "Start time in microseconds"
              },
              {
                "name": "endTime",
                "value": "",
                "type": "query",
                "description": "End time in microseconds"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results (default 500, max 1000)"
              }
            ]
          },
          "docs": "All Orders (order history from ClickHouse)"
