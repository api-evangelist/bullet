        {
          "id": "11bde7e0-41b0-4842-8e79-9a37c496b1d6",
          "name": "Simulate a transaction against the current rollup state without committing.",
          "request": {
            "name": "Simulate a transaction against the current rollup state without committing.",
            "description": {
              "content": "Pass-through proxy to the sequencer's `/rollup/simulate`. The body is a JSON\n`SimulateParameters` document (runtime `call` + `sender`), NOT a signed borsh\ntx, so this route intentionally skips the tx validators and forwards the\nrequest unchanged — mirroring the rest of the `/rollup/*` passthrough.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rollup",
                "simulate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sender\": \"<string>\",\n  \"call\": \"<object>\",\n  \"sequencer\": {\n    \"da_address\": \"<string>\",\n    \"rollup_address\": \"<string>\"\n  },\n  \"tx_details\": {\n    \"gas_limit\": [\n      \"<long>\",\n      \"<long>\"\n    ],\n    \"max_fee\": \"<string>\",\n    \"max_priority_fee_bips\": \"<uint64>\"\n  },\n  \"uniqueness\": \"<object>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "ea70922d-db7a-42d5-9f95-68927615098f",
              "name": "Simulation completed",
              "originalRequest": {
                "url": {
                  "path": [
                    "rollup",
                    "simulate"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
