                  "raw": "{\n  \"sender\": \"<string>\",\n  \"call\": \"<object>\",\n  \"sequencer\": {\n    \"da_address\": \"string\",\n    \"rollup_address\": \"string\"\n  },\n  \"tx_details\": {\n    \"gas_limit\": [\n      7665,\n      9006\n    ],\n    \"max_fee\": \"string\",\n    \"max_priority_fee_bips\": 6486\n  },\n  \"uniqueness\": \"<object>\"\n}",
                  "options": {
