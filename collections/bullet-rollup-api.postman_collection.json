              "body": "{\n  \"events\": [\n    {\n      \"value\": {},\n      \"key\": \"string\",\n      \"module\": \"string\"\n    },\n    {\n      \"value\": {},\n      \"key\": \"string\",\n      \"module\": \"string\"\n    }\n  ],\n  \"gas_used\": \"string\",\n  \"outcome\": \"success\",\n  \"priority_fee\": \"string\"\n}",
